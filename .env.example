# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="your_app_url_here"

# FPT AI Cloud API key (External Compute Lane)
FPT_API_KEY="your_fpt_api_key_here"

# NVIDIA NIM Compute Key (Acceleration Lane)
NVIDIA_API_KEY="your_nvidia_api_key_here"

# FIREBASE_API_KEY: Optional client API key for Firebase Firestore persistence
FIREBASE_API_KEY=""
VITE_FIREBASE_API_KEY=""

# OPENAI_API_KEY: Optional frontier model key for OpenAI reasoning rail
OPENAI_API_KEY=
OPENAI_MODEL=
