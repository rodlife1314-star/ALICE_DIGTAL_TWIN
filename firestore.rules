rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTwin(data) {
      return data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 256
        && data.domain is string;
    }

    match /twins/{twinId} {
      allow read: if true;
      allow create, update: if isValidId(twinId) && isValidTwin(request.resource.data);
      allow delete: if isValidId(twinId);
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
