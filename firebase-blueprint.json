{
  "entities": {
    "DigitalTwin": {
      "title": "Digital Twin",
      "description": "Domain-neutral digital twin entity definition",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the digital twin"
        },
        "name": {
          "type": "string",
          "description": "Display name of the twin"
        },
        "domain": {
          "type": "string",
          "description": "Domain classification (biological, engineered, environmental, musical, physical)"
        },
        "purpose": {
          "type": "string",
          "description": "Operational purpose of the twin"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "name", "domain"]
    },
    "SubstrateDelta": {
      "title": "Substrate Delta",
      "description": "Audited governance patch, learning dimension, and rule promotion record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "observation": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "learning": {
          "type": "string"
        },
        "internalizedRule": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": ["userId", "observation", "internalizedRule"]
    },
    "PathfinderSession": {
      "title": "Pathfinder Session",
      "description": "Active session with evidence documents, inquiry, and selected pathway",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "inquiry": {
          "type": "string"
        },
        "selectedPathwayId": {
          "type": "string"
        }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/twins/{twinId}": {
      "schema": "DigitalTwin",
      "description": "Collection storing digital twin models and evidence configurations"
    },
    "/substrate_deltas/{deltaId}": {
      "schema": "SubstrateDelta",
      "description": "Collection storing versioned substrate delta ledger and internalized governance rules"
    },
    "/sessions/{sessionId}": {
      "schema": "PathfinderSession",
      "description": "Collection storing interactive operator reasoning sessions"
    }
  }
}
